# Server-side rewrite: /socket.io → VPS (required at build on Cloudflare Workers).
# Use a hostname (not bare IP) on Workers — bare IP causes CF error 1003 on /socket.io.
VPS_BACKEND_URL=http://167-104-100-68.nip.io:3001

# Optional. Leave unset in production so the client uses same-origin + rewrite (HTTPS-safe).
# Local dev with backend on :3001: set to http://127.0.0.1:3001
# NEXT_PUBLIC_VPS_URL=http://127.0.0.1:3001

# CSP frame-ancestors for /live (who may embed this app in an iframe).
# Origin only: scheme + host, NO trailing slash, NO path.
# Cloudflare: set under Build → Variables (required at deploy build time).
# Example:
FRAME_ANCESTORS='self' https://osaka-nu-orpin.vercel.app/

# Origins allowed to embed /live in an iframe (CSP frame-ancestors).
# Use the full origin: scheme + host, no path. Separate multiple origins with spaces.
# Include 'self' if the same domain should also embed itself.
# Example: 'self' https://my-landing.vercel.app https://www.my-domain.com
FRAME_ANCESTORS='self' https://your-vercel-domain.vercel.app